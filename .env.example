# =============================================================================
# Kabanchik (Telecom Scrum Agent) — environment template
# =============================================================================
# Copy to .env and fill in. Never commit .env.
# Sections marked [GCP-only] are needed only for cloud deploy.
# Sections marked [optional] can be left empty if the corresponding feature is
# mocked or disabled.
# =============================================================================


# ---- Core app -------------------------------------------------------------
# JWT signing key for backend-issued sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Only emails on this domain may log in.
ALLOWED_DOMAIN=municorn.com

# Runtime boundary:
# - production: real use; every protected API call requires a valid bearer JWT.
# - agent_preview: Codex/agent preview; local UI can inspect all projects without
#   reusing a real user's session. Do not use this for shared/real deployments.
APP_ENVIRONMENT=production
NEXT_PUBLIC_APP_ENVIRONMENT=production

# Where the frontend lives; used for CORS + OAuth redirect building.
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000


# ---- OpenAI (required) ----------------------------------------------------
# Run scripts/sanity_check.py to confirm the key can see this model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini


# ---- Google Workspace (required) ------------------------------------------
# OAuth Web client (login). Redirect URIs to register in GCP console:
#   http://localhost:8000/auth/google/callback
#   https://<PUBLIC_HOSTNAME>/auth/google/callback   (GCP only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Service Account JSON for Calendar + Meet + Drive (domain-wide delegation).
# Local: drop the file at data/keys/sa_key.json and leave this path as-is.
# GCP:   pulled from Secret Manager (scrumagent-sa-key) to the same path.
GOOGLE_APPLICATION_CREDENTIALS=/app/data/keys/sa_key.json

# Workspace admin whose identity the SA impersonates.
GOOGLE_WORKSPACE_SUBJECT=admin@municorn.com


# ---- Atlassian Rovo (Jira) [optional] -------------------------------------
# Leave empty to mock the jira_notion agent's Jira side.
ROVO_BASE_URL=https://api.atlassian.com/rovo
ROVO_API_TOKEN=
ATLASSIAN_SITE_URL=https://municorn.atlassian.net
ATLASSIAN_USER_EMAIL=


# ---- Notion (MCP) [optional] ----------------------------------------------
# Leave empty to mock the jira_notion agent's Notion side.
NOTION_MCP_URL=https://mcp.notion.com/v1/sse
NOTION_TOKEN=


# ---- LightRAG multimodal RAG ---------------------------------------------
# Backend-facing adapter settings. Backend code must call app/rag.py and use
# LightRAG only through this HTTP boundary.
RAG_PROVIDER=lightrag
LIGHTRAG_BASE_URL=http://lightrag:9621
LIGHTRAG_WORKSPACE=scrumagent
LIGHTRAG_TIMEOUT_SECONDS=10
LIGHTRAG_API_KEY=

# LightRAG service model settings. Compose maps OPENAI_API_KEY into LightRAG for
# provider auth; these values select the LightRAG-side model names/dimensions.
LIGHTRAG_LLM_MODEL=gpt-5.4-mini
LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
LIGHTRAG_EMBEDDING_DIM=1536

# LightRAG PostgreSQL storage settings. Local Compose uses the `postgres`
# service; GCP should point the same settings at Cloud SQL PostgreSQL through
# private IP or the Cloud SQL Auth Proxy.
LIGHTRAG_POSTGRES_HOST=postgres
LIGHTRAG_POSTGRES_PORT=5432
LIGHTRAG_POSTGRES_USER=rag
LIGHTRAG_POSTGRES_PASSWORD=rag
LIGHTRAG_POSTGRES_DATABASE=lightrag
LIGHTRAG_POSTGRES_MAX_CONNECTIONS=25
LIGHTRAG_POSTGRES_VECTOR_INDEX_TYPE=HNSW
LIGHTRAG_POSTGRES_SSL_MODE=disable

# Legacy on-disk RAG path kept for older local scripts; LightRAG does not use it.
RAG_STORAGE_PATH=/app/data/rag


# ---- SQLite ---------------------------------------------------------------
DATABASE_URL=sqlite:////app/data/db/scrumagent.db


# ---- Logging --------------------------------------------------------------
LOG_LEVEL=INFO


# =============================================================================
# GCP deployment [GCP-only] — skip if running only via local Docker Compose
# =============================================================================

# Project + location
GCP_PROJECT_ID=
GCP_REGION=europe-west1
GCP_ZONE=europe-west1-b

# Public hostname the VM serves on (DNS A record points to the static IP).
PUBLIC_HOSTNAME=kabanchik.municorn.com

# Caddy / Let's Encrypt
LETSENCRYPT_EMAIL=

# Secret Manager refs (entries created out-of-band by ops)
SM_ENV_SECRET=scrumagent-env
SM_SA_KEY_SECRET=scrumagent-sa-key
